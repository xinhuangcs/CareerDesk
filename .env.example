# Copy to .env while CareerDesk is stopped, keep mode 600, and never commit or log it.
# Use a separate file and separate provider credentials for every deployment.
# Installed desktop API keys belong in the operating-system credential store.

# Local source checkout. Public server mode fails closed if required security settings are absent.
# APP_RUNTIME_MODE=desktop
# APP_DEBUG=true
# APP_DEV_FAKE_USER=me

# Desktop synchronizes the system IANA zone; servers must configure this explicitly.
APP_TIMEZONE=Asia/Shanghai

# Model format is provider:model. Explicit model IDs require both capacity values from that model.
# APP_LLM_MODEL=anthropic
# APP_LLM_CONTEXT_WINDOW=
# APP_LLM_MAX_OUTPUT_TOKENS=

# Source checkout and server provider credentials; installed desktop builds use secure storage.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# OpenAI-compatible endpoints must not contain credentials, query parameters, or fragments.
# OPENAI_BASE_URL takes precedence over LLM_BASE_URL.
# APP_LLM_MODEL=openai_compatible:your-model
# OPENAI_BASE_URL=https://gateway.example.com/v1
# LLM_BASE_URL=https://gateway.example.com/v1
# LLM_API_KEY=

# Optional capabilities also require the explicit network permissions below.
# OPENAI_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# GOOGLE_PSE_API_KEY=
# GOOGLE_PSE_ENGINE_ID=
# SEARXNG_BASE_URL=

# Credentials indicate availability, not consent. Outbound capabilities default off.
# Strict offline overrides cloud and network permissions without deleting their configuration.
APP_STRICT_OFFLINE=false
APP_ALLOW_CONVERSATION_EMBEDDING=false
APP_ALLOW_WEB_RESEARCH=false
APP_ALLOW_DEEP_RESEARCH=false
APP_ALLOW_DDG_FALLBACK=true

# Never place the live SQLite/WAL database on a sync or network drive. Docker Desktop requires a
# named /app/data volume; synchronize only verified SQLite Online Backup archives.
# APP_DATA_DIR=data
# APP_LOG_DIR=logs

# Authenticated server deployment. APP_GATEWAY_AUTH_SECRET must remain empty locally.
# APP_RUNTIME_MODE=server
# APP_DEBUG=false
# APP_DEV_FAKE_USER=
# APP_ALLOWED_HOSTS=careerdesk.example.com
# APP_ALLOWED_ORIGINS=https://careerdesk.example.com
# APP_GATEWAY_AUTH_SECRET=
